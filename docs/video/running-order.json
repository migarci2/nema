  "voice": [
    {
      "name": "vo-01",
      "at": 13.573333,
      "text": "A cooking course I have never opened. It wants to know three things about me. It asks my nema, not me."
    },
    {
      "name": "vo-02",
      "at": 22.573332999999998,
      "text": "I say yes. That is all it gets."
    },
    {
      "name": "vo-03",
      "at": 26.673333000000003,
      "text": "68 minutes become 27. It skips what I already know."
    },
    {
      "name": "vo-04",
      "at": 42.673333,
      "text": "I do one exercise. The course gives me a note that says I passed. That note is mine. I keep it in my nema."
    },
    {
      "name": "vo-05",
      "at": 63.92,
      "text": "A different site. It asks, I say yes, and it already counts what I did before."
    },
    {
      "name": "vo-06a",
      "at": 70.52000000000001,
      "text": "Two lessons done before I start. The lab opens."
    },
    {
      "name": "vo-06b",
      "at": 75.52000000000001,
      "text": "With the extension it is one click. My notes come home alone."
    },
    {
      "name": "vo-07a",
      "at": 84.72,
      "text": "This is a real article, with questions inside the text."
    },
    {
      "name": "vo-07b",
      "at": 100.88333299999998,
      "text": "One tag on the page. That is all."
    },
    {
      "name": "vo-08",
      "at": 104.25333299999998,
      "text": "If you teach on the web, you can add this in one minute."
    },
    {
      "name": "vo-webmcp-a",
      "at": 34.383333,
      "text": "Every page shows what it can do with WebMCP."
    },
    {
      "name": "vo-webmcp-b",
      "at": 94.08333299999998,
      "text": "Any agent can use it, and my nema answers only what I approve."
    }
  ],
