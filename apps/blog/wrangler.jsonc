{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nema-blog",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // The third example: an ordinary blog post that installs nema with one tag.
  // No Worker script and no issuer secret. The key that signs its receipts is
  // generated in the reader's browser, so there is no /.well-known/nema-issuer.json
  // to publish and the receipts land in the vault's self certified tier.
  "assets": {
    "directory": "../../dist/blog"
  },
  "routes": [
    { "pattern": "maillard.migarci2.dev", "custom_domain": true }
  ]
}
