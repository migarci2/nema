{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nema-cpu",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // The second real article, mirrored as it is (MIT, see LICENSE.article) with
  // nema added by the embed install. Like the blog and the AES-GCM mirror,
  // this origin carries the article and nothing else: no Worker script, no
  // issuer secret, no copy of shared/. It loads the embed and the modules the
  // embed imports from the hub, cross origin, and its receipts are signed by a
  // key generated in the reader's browser, so they land in the vault's self
  // certified tier.
  "assets": {
    "directory": "../../dist/cpu"
  },
  "routes": [
    { "pattern": "cpu.migarci2.dev", "custom_domain": true }
  ]
}
